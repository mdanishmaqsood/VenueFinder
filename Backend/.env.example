SECRET_KEY=change-me-to-a-long-random-string
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1

# These three must match the password in DATABASE_URL
POSTGRES_DB=venuefinder
POSTGRES_USER=venuefinder
POSTGRES_PASSWORD=venuefinder

DATABASE_URL=postgres://venuefinder:venuefinder@db:5432/venuefinder
REDIS_URL=redis://redis:6379/0

OPENAI_API_KEY=sk-...your-key-here...

# AI search tuning
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-3.5-turbo
AI_TOP_K_CANDIDATES=15
AI_MAX_RESULTS=5
OPENAI_TIMEOUT=30
